// version details shown by Windows in the program's Properties; filled in by CMake
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Nathan Chiamsachang"
            VALUE "FileDescription",  "TCG Tournament Manager"
            VALUE "FileVersion",      "@TCG_VERSION@"
            VALUE "InternalName",     "TcgTournamentManager"
            VALUE "OriginalFilename", "TcgTournamentManager.exe"
            VALUE "ProductName",      "TCG Tournament Manager"
            VALUE "ProductVersion",   "@TCG_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
